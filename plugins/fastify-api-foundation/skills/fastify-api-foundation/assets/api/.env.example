# Copy to apps/api/.env for local dev (dotenv/config loads ".env" from the cwd).
# Hosted environments set these in the platform dashboard — never commit real values.

# How the code runs: development | test | production
NODE_ENV=development
# Which deployment this is: development | hml | production (production NODE_ENV requires hml|production)
APP_ENV=development

HOST=0.0.0.0
PORT=3333
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Runtime connection. Local: Docker. Supabase: transaction pooler, port 6543, ?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db?schema=public

# Migrations only (direct / session pooler, port 5432). Required for `prisma migrate` in hml/production.
# DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Comma-separated allowed origins; "*" wildcards allowed (e.g. https://*-team.vercel.app)
CORS_ORIGIN=http://localhost:5173

# lax | strict | none  (none only when web and API are on different sites)
COOKIE_SAME_SITE=lax
