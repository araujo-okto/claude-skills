{
  "name": "my-project",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @my-project/api",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run prisma:validate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:push": "npm run db:push --workspace @my-project/api",
    "db:seed": "npm run db:seed --workspace @my-project/api",
    "db:setup": "npm run db:setup --workspace @my-project/api",
    "dev:api": "npm run dev --workspace @my-project/api",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prisma:generate": "npm run prisma:generate --workspace @my-project/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @my-project/api",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace @my-project/api",
    "prisma:validate": "npm run prisma:validate --workspace @my-project/api",
    "start": "npm run start --workspace @my-project/api",
    "test": "npm run test --workspace @my-project/api",
    "typecheck": "npm run typecheck --workspace @my-project/api"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
